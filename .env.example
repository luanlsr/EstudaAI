# Database (em docker-compose, o host é 'db')
DATABASE_URL=postgresql://postgres:password@db:5432/knowledge

# Redis (em docker-compose, o host é 'redis')
REDIS_URL=redis://redis:6379/0

# LLM & Embeddings (ex: OpenAI)
OPENAI_API_KEY=your_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o

# Storage Configuration
STORAGE_PROVIDER=local # ou s3
STORAGE_LOCAL_PATH=./knowledge/documents

# Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MIN_CHUNK_SIZE=100
MAX_CHUNK_SIZE=1500
